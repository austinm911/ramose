{
  "name": "ripple",
  "version": "0.1.0",
  "private": true,
  "description": "Ripple — an immutable, Datomic-inspired database for Cloudflare (Workers + Durable Objects + R2).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test packages/core packages/storage packages/transactor packages/replica packages/worker packages/alchemy examples/todos",
    "test:all": "bun test",
    "test:e2e": "bun test test/e2e",
    "test:e2e:cf": "bash scripts/e2e-cloudflare.sh",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "bench": "bun run bench/run.ts",
    "bench:seek": "bun run bench/seek.bench.ts",
    "bench:join": "bun run bench/join.bench.ts",
    "bench:write": "bun run bench/write.bench.ts",
    "bench:transactor": "bun run bench/transactor.bench.ts",
    "bench:write-do": "bun run bench/write-do.bench.ts",
    "bench:read-do": "bun run bench/read-do.bench.ts",
    "bench:indexer": "bun run bench/indexer.bench.ts",
    "dev": "bun alchemy dev",
    "deploy": "bun alchemy deploy",
    "deploy:prod": "bun alchemy deploy --stage prod",
    "destroy": "bun alchemy destroy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@stylexjs/stylex": "^0.19.0",
    "@stylexjs/unplugin": "^0.19.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "^2.0.0-beta.72",
    "@effect/platform-bun": ">=4.0.0-beta.105",
    "@effect/platform-node": ">=4.0.0-beta.105",
    "@ripple/alchemy": "workspace:*",
    "alchemy": "latest",
    "better-auth": "^1.6.30",
    "effect": ">=4.0.0-beta.105"
  }
}
