---
/**
 * Primary lockup: the ramose mark + the wordmark, per the brand guide —
 * "ramose." in white (the period included) and only "ai" in the brand green.
 *
 * The mark lives in `src/assets/ramose-mark.svg`; Astro turns an imported SVG
 * into a component, so it inlines (and can be sized) rather than loading an
 * extra request. The asset strokes the closed loop with `currentColor` and
 * hard-codes the growing branch to the brand green (#42D37A), so the loop
 * takes whatever `color` this component sets — `--sl-color-white` below.
 */
import RamoseMark from "../assets/ramose-mark.svg";
---

<a href="/" class="rg-site-title">
  <span class="rg-mark"><RamoseMark aria-hidden="true" /></span>
  <span class="rg-word">ramose.<span class="rg-word-tld">ai</span></span>
</a>

<style>
  .rg-site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: var(--sl-color-white);
    min-width: 0;
  }
  /* The mark renders as a child component, so reach it with :global —
     scoped styles do not cross the component boundary. */
  .rg-mark {
    display: flex;
    flex-shrink: 0;
  }
  /* The asset ships a viewBox but no width/height, so pin the height and let
     the 305:169 aspect ratio derive the width rather than trusting the UA's
     default 100% width for sized-less SVG. */
  .rg-mark :global(svg) {
    display: block;
    height: 1.375rem;
    width: auto;
    aspect-ratio: 305 / 169;
  }
  .rg-word {
    font-weight: 600;
    font-size: var(--sl-text-lg);
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--sl-color-white);
  }
  .rg-word-tld {
    color: var(--sl-color-accent);
  }
</style>
